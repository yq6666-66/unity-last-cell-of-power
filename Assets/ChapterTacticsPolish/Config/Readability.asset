  shutterTutorial: "\u4E24\u4FA7\u5F00\u5173\u5171\u7528\u4E00\u6247\u95E8\u3002\u5B8C\u5168\u95ED\u5408\u624D\u6D88\u8017\u6B21\u6570\uFF1B\u95E8\u53E3\u6709\u4EBA\u4F1A\u62D2\u7EDD\u6216\u53D6\u6D88\u3002"
  helpQTitle: "Q \xB7 \u5355\u76EE\u6807\u5E72\u6270"
  helpQBody: "\u8DDD\u79BB\u2264{0:0.#}\u7C73\u4E14\u65E0\u906E\u6321\uFF0C\u4EC5\u4F5C\u7528\u4E8E\u8B66\u89C9/\u8FFD\u51FB\u4E2D\u7684\u6700\u8FD1\u76EE\u6807\u3002\n\u9700{1:0}\u7535\u91CF\uFF0C\u547D\u4E2D\u8017{2:0}\uFF1B\u4E00\u6B21\u53EA\u5E72\u6270\u4E00\u53F0\u3002"
  helpNoiseTitle: "N01 / N02 \xB7 \u8BF1\u5BFC\u626C\u58F0\u5668"
  helpNoiseBody: "\u540C\u53F7\u626C\u58F0\u5668\u53D1\u58F0{0:0.#}\u79D2\uFF0C\u6BCF\u53F0\u4E00\u6B21\u3001\u4E0D\u8017\u7535\u3002\n\u770B\u5230\u4F60\u7684\u673A\u5668\u4EBA\u4ECD\u4F18\u5148\u8FFD\u4F60\uFF1B\u66FE\u54CD\u5E94\u8868\u793A\u63A5\u53D7\u8FC7\u8C03\u67E5\u3002"
  helpShutterTitle: "S01 \xB7 \u4E34\u65F6\u9694\u65AD\u95E8"
  helpShutterBody: "\u4E24\u4FA7 S01 \u5171\u7528\u4E00\u6247\u95E8\uFF0C\u5B8C\u5168\u95ED\u5408\u624D\u6D88\u8017\u6B21\u6570\u3002\n\u5360\u4F4D\u4F1A\u62D2\u7EDD\u6216\u53D6\u6D88\uFF0C\u6B21\u6570\u4FDD\u7559\uFF1B\u95ED\u9501{0:0.#}\u79D2\u540E\u56DE\u5F00\u3002"
  helpControls: "WASD \u79FB\u52A8 \xB7 \u9F20\u6807\u89C2\u5BDF \xB7 E \u8BBE\u5907
    \xB7 Esc \u8FD4\u56DE"
